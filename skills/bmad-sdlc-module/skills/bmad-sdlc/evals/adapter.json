{
  "name": "opencode-deepseek",
  "invocation": [
    "opencode",
    "run",
    "--model",
    "deepseek/deepseek-flash",
    "--format",
    "json",
    "--auto",
    "{prompt}"
  ],
  "transcript": {
    "format": "stdout-jsonl"
  },
  "skill_dir": ".agents/skills",
  "load_signal": {
    "skill_tool": "skill",
    "read_tool": "read"
  },
  "env_passthrough": ["XDG_DATA_HOME", "XDG_CONFIG_HOME"]
}
